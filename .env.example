# Copy file ini jadi .env, lalu isi nilai aslinya di .env (jangan di sini).
# .env TIDAK BOLEH di-commit ke Git.

# Username & password akun SCELE lo (buat login otomatis via requests.Session()).
SCELE_USERNAME=
SCELE_PASSWORD=

# Link forum yang mau dipantau, format: mod/forum/view.php?id=XXXXX
# Bisa lebih dari satu, pisahin pake koma. Boleh dikosongin dulu kalau
# belum ada forum yang mau dipantau (cuma Timeline yang jalan).
SCELE_FORUM_URLS=

# Bot Telegram (dari @BotFather) & Chat ID (dari @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: set ke 1 buat nyimpen HTML mentah hasil fetch ke folder
# debug_html/, berguna buat ngecek kenapa scraping gak nemu apa-apa.
# Jangan diaktifin di GitHub Actions (gak perlu, cuma numpuk).
DEBUG_SAVE_HTML=
